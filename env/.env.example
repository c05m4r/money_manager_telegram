# Copyright (C) 2026 Marcos Gabriel Miller
# Copy to env/.env and fill in. env/.env is git-ignored.

# Required. Token from @BotFather.
TELOXIDE_TOKEN=123456:ABC-replace-me

# Base URL of money_manager_backend.
# From Docker, use http://host.docker.internal:8000/api/v1 and run the backend with APP_HOST=0.0.0.0.
BACKEND_API_URL=http://127.0.0.1:8000/api/v1

# Optional. Comma-separated Telegram user IDs allowed to use the bot. Empty = everyone.
# Ask @userinfobot for your ID.
ALLOWED_TELEGRAM_IDS=

# Store credentials encrypted (AES-256-GCM) so the bot re-logs in when the JWT expires.
# false = users are asked to /login again every JWT_EXP_HOURS (24 h by default).
STORE_CREDENTIALS=true
# Required when STORE_CREDENTIALS=true. 32 bytes in base64: openssl rand -base64 32
# Changing or losing it invalidates stored credentials (users /login again).
CREDENTIALS_KEY=

# SQLite file for sessions and dialogues. Created with 0600 permissions.
DATABASE_PATH=data/bot.sqlite

# IANA time zone used to read and show dates.
BOT_TZ=America/Argentina/Buenos_Aires

CACHE_TTL_SECS=300
PAGE_SIZE=10
HTTP_TIMEOUT_SECS=10
RUST_LOG=info
